# ---------------------------------------------------------------------------
# JIS Beauty & Fashion — environment variables
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon, Supabase, Railway, local, ...)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Set to "true" for managed providers that require SSL
DATABASE_SSL=false

# Public URL of the site (used for Paystack callbacks, emails, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign/derive auth tokens. Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Paystack (https://dashboard.paystack.com/#/settings/developers)
# Online payments stay disabled in the UI until PAYSTACK_SECRET_KEY is set.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Transactional email (password resets, order emails). Optional.
# Provider adapter lives in src/lib/email.ts — Resend is wired up by default.
RESEND_API_KEY=
EMAIL_FROM="JIS Beauty & Fashion <hello@jisbeauty.ng>"

# Bank transfer details shown on the order confirmation page for manual payments
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=JIS Beauty & Fashion
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=

# Seeded admin account (only used by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@jisbeauty.ng
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Demo products are NOT auto-inserted unless explicitly enabled for private preview.
ENABLE_DEMO_SEED=false

# Optional: store all uploaded product/variant photos in Supabase Storage.
# First create a PUBLIC bucket named product-images in the Supabase dashboard.
# These values are SERVER-ONLY. Never use NEXT_PUBLIC_ for the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Alternative: use existing Vercel Blob storage instead of Supabase Storage.
# Images_STORE_ID=<your existing Vercel Blob store ID>
